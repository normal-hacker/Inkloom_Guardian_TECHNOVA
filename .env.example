# ==============================================================================
# INKLOOM GUARDIAN — SHARED ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env at the project root for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Server-side only — DO NOT expose to frontend)
# ------------------------------------------------------------------------------
# For local Docker PostgreSQL:
POSTGRES_USER=guardian
POSTGRES_PASSWORD=guardian
POSTGRES_DB=guardian
POSTGRES_PORT=5432
DATABASE_URL=postgresql://guardian:guardian@localhost:5432/guardian

# For Supabase / Managed Postgres, use the Pooler connection string:
# Format: postgresql://postgres.[project-ref]:[URL-ENCODED-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Server-side only — DO NOT expose to frontend)
# ------------------------------------------------------------------------------
# Secret key used for signing session cookies and JWT tokens (>= 32 characters)
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Enable passwordless demo persona logins for hackathon evaluation
DEMO_MODE=true
# Base canonical URL of the application
AUTH_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. AI / LLM CONFIGURATION (Server-side only — DO NOT expose to frontend)
# ------------------------------------------------------------------------------
# Options: 'mock', 'gemini', 'anthropic'
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_S=20
MAX_UPLOAD_MB=10

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH CONFIGURATION (Optional, Server-side only)
# ------------------------------------------------------------------------------
# Leave blank to disable Google sign-in (demo personas remain active)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. FRONTEND / CLIENT-SIDE CONFIGURATION (Exposed to browser via NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Base path for client-side API requests (defaults to same-origin /api/v1)
NEXT_PUBLIC_API_URL=/api/v1