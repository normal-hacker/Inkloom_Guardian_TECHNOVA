{
  "name": "inkloom-guardian",
  "version": "1.0.0",
  "private": true,
  "description": "Inkloom Guardian — Full-Stack Brand Governance & Quality Checks System",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
